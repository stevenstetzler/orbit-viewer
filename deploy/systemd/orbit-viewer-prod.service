
# Production unit -- fixed port, fixed directory, no per-branch
# templating (see orbit-viewer@.service for that). Install once: copy
# to /etc/systemd/system/, `systemctl daemon-reload`,
# `systemctl enable --now orbit-viewer-prod.service`. Deploys after
# that just `systemctl restart` it (deploy/sudo/orbit-viewer-deploy-prod.sh)
# once deploy/sync-and-build.sh has synced the new commit into
# /srv/orbit-viewer/prod.
#
# Replace RUNNER_USER below with the actual account the self-hosted
# runner service runs as (see deploy/README.md) before installing. The
# port here (9000) must match deploy/nginx/orbit-viewer-prod.conf's own
# proxy_pass -- see deploy/README.md if you want to change it.

[Unit]
Description=orbit-viewer production
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/orbit-viewer/prod
ExecStart=/usr/bin/env node scripts/serve-example.mjs --port 9000
Restart=on-failure
RestartSec=2
User=RUNNER_USER
Group=RUNNER_USER

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/orbit-viewer/prod /srv/orbit-viewer/cache

[Install]
WantedBy=multi-user.target
